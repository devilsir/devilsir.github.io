{
  "name": "VOICES original pixel world expansion",
  "version": 1,
  "tileSize": 32,
  "npcSprite": {
    "pattern": "assets/characters/{id}.png",
    "width": 128,
    "height": 192,
    "cellWidth": 32,
    "cellHeight": 32,
    "columns": 4,
    "rows": {
      "down": 0,
      "left": 1,
      "right": 2,
      "up": 3,
      "interaction": 4,
      "celebration": 5
    },
    "idleColumn": 0
  },
  "npcPortrait": {
    "pattern": "assets/characters/{id}-portrait.png",
    "width": 288,
    "height": 96,
    "cellWidth": 96,
    "cellHeight": 96,
    "columns": {
      "neutral": 0,
      "happy": 1,
      "concerned": 2
    }
  },
  "characters": [
    "gardener",
    "vendor",
    "guide",
    "archivist",
    "technician",
    "teacher",
    "courier",
    "elder",
    "student2",
    "percussionist"
  ],
