    "width": 128,
    "height": 192,
    "cellWidth": 32,
    "cellHeight": 32,
    "frames": 4,
    "rows": {
      "dog": 0,
      "cat": 1,
      "pigeon": 2,
      "bird": 3,
      "duck": 4,
      "butterfly": 5
    },
    "crop": "sx=frame*32;sy=row*32"
  },
